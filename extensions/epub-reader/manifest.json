{
  "manifest_version": 3,
  "name": "EPUB Reader",
  "version": "0.1.0",
  "description": "Open EPUBs in a viewer that reads them aloud, word by word, with a neural voice that runs on this machine.",
  "permissions": ["declarativeNetRequest", "contextMenus", "storage", "tts"],
  "host_permissions": ["*://*/*", "file://*/*"],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Open this book in EPUB Reader"
  },
  "web_accessible_resources": [
    {
      "resources": ["viewer.html"],
      "matches": ["<all_urls>"]
    }
  ]
}
