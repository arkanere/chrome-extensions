{
  "manifest_version": 3,
  "name": "Reading Mode",
  "version": "1.0.0",
  "description": "Turn any article into a clean, distraction-free reading view. Click the icon to toggle, Esc to close.",
  "permissions": ["activeTab", "scripting"],
  "host_permissions": [
    "https://api.dictionaryapi.dev/*",
    "https://en.wikipedia.org/*",
    "https://generativelanguage.googleapis.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": ["reader.css"],
      "matches": ["http://*/*", "https://*/*"]
    }
  ]
}
