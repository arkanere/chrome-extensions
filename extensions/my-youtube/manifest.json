{
  "manifest_version": 3,
  "name": "my-youtube",
  "version": "0.2.0",
  "description": "A quieter YouTube: no Shorts, no up-next column, no endscreen bait, channels you have tagged away, and a daily limit on the homepage.",
  "permissions": ["storage"],
  "content_scripts": [
    {
      "matches": ["*://www.youtube.com/*"],
      "css": ["src/clean.css", "src/bar.css", "src/filter.css"],
      "js": [
        "src/router.js",
        "src/tick.js",
        "src/lib/extract.js",
        "src/lib/tags.js",
        "src/lib/budget.js",
        "src/lib/tagger.js",
        "src/lib/bar.js",
        "src/pages/home.js",
        "src/pages/watch.js"
      ],
      "run_at": "document_start",
      "all_frames": false
    }
  ]
}
